# Copy to .env (git-ignored) and edit. docker compose reads it on start:
#   cp .env.example .env && docker compose up -d
# After a change, run docker compose up -d again (a restart doesn't reread
# .env). What is set here can't be changed on the settings page, and the
# rest of the settings live only there. System > Services shows these.
# Shell variables override .env, except the API keys and PANEL_TOKEN (read from .env only).

# --- What runs ---
# emaki and whisper always run. These pick the rest:
# GPU: empty is CPU only, vulkan an AMD or Intel GPU on Linux, vulkan-wsl
# the same on Windows (WSL). What the host needs is at the end of docker-compose.yml.
GPU=
# local runs Ollama for topics; external leaves it out (see below).
TOPIC_MODEL=local
# 1 runs imagegen, which draws the pictures on this machine (see Images below).
LOCAL_IMAGES=
# 1 adds Danish and Norwegian speech models to whisper (see below).
WHISPER_DA_NO=
# 1 builds E-maki from this checkout instead of pulling the released image.
EMAKI_BUILD=
# Turns TOPIC_MODEL and LOCAL_IMAGES into the containers that run. Leave it as is.
COMPOSE_PROFILES=topics-${TOPIC_MODEL:-local},${LOCAL_IMAGES:+local-images}

# --- Images (the only thing that leaves the house is the image prompt) ---
# Set up one or more; the settings page (System > Image provider) picks which
# one draws. With none set up the frame shows placeholder tiles. You pay for
# your own images.
#
# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# OpenAI: key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
# Any other service with an OpenAI-style /v1/images/generations endpoint:
# put its address here (up to and including /v1) and its key above.
OPENAI_BASE_URL=
# OpenRouter: one key for many image models. Pick one that outputs images at
# https://openrouter.ai/models (filter on image output) and paste its id.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=
#
# On this machine, nothing leaves the house: set LOCAL_IMAGES=1 above
# (see docs/local-images.md). The default model is
# FLUX.2 klein 4B. Other models: give the file URLs, and set the text encoder
# and VAE to "none" for a single-file checkpoint.
SD_MODEL_URL=
SD_TEXT_ENCODER_URL=
SD_VAE_URL=
# Steps per picture (4 for FLUX.2 klein), CPU threads (empty uses all cores),
# extra sd-server flags, the picture size, and the name the settings page shows.
SD_STEPS=
SD_THREADS=
SD_ARGS=
LOCAL_IMAGE_SIZE=1024x768
LOCAL_IMAGE_MODEL=

# --- Time zone, for quiet hours and the times on the frame ---
TZ=Europe/Copenhagen

# --- Speech-to-text (whisper.cpp) ---
# ggml model name from huggingface.co/ggerganov/whisper.cpp:
#   small (fast on a laptop CPU), large-v3-turbo-q5_0 (accurate, needs a GPU or a fast CPU)
WHISPER_MODEL=small
# Or a full URL to a ggml fine-tune (Edda for Danish, NB-Whisper for Norwegian).
# Only use a source you trust. Optionally give the file's SHA-256 to verify it.
WHISPER_MODEL_URL=
WHISPER_MODEL_SHA256=
# CPU threads; empty uses all cores.
WHISPER_THREADS=8
# Danish and Norwegian models next to stock Whisper, with WHISPER_DA_NO=1
# above. Edda has no official ggml file: use a
# conversion you trust and pin its SHA-256. NB-Whisper defaults to medium q5_0.
# WHISPER_DA_MODEL_URL=
# WHISPER_DA_MODEL_SHA256=
# WHISPER_NO_MODEL_URL=
# Name each model is saved under; change it when you change its URL.
# WHISPER_DA_MODEL=edda-v0.2
# WHISPER_NO_MODEL=nb-whisper-medium-q5_0

# --- Topic LLM (Ollama, on this machine) ---
# Downloaded on the first start, then kept. Set LLM_MODEL_UPDATE=1 for one
# start to fetch a newer upload of the same tag. Lightest first:
#   qwen3.5:2b      ~2.7 GB, lightest usable, vaguer topics
#   qwen3.5:4b      ~3.4 GB, default, runs with thinking off
#   gemma4:e4b      ~5.5 GB, set LLM_REASONING= (empty) below
#   gemma4:26b-a4b  ~16 GB, best topics on a 32 GB laptop; LLM_REASONING= too
LLM_MODEL=qwen3.5:4b
# Sent as reasoning_effort. none stops Qwen thinking for a minute per topic.
# Leave it empty for models that don't think, like Gemma.
LLM_REASONING=none

# --- External topic model (optional, off by default) ---
# Instead of Ollama, send the transcript window to a service with an
# OpenAI-compatible chat API. This means WHAT IS SAID IN THE ROOM LEAVES YOUR
# NETWORK (see PRIVACY.md). Setting these only makes it available: pick it on
# the settings page (Listening > Topics).
# The API's base address (the part before /chat/completions), for example
#   https://api.openai.com/v1 (the default), https://openrouter.ai/api/v1,
#   https://api.groq.com/openai/v1,
#   https://generativelanguage.googleapis.com/v1beta/openai (Gemini)
# The model must accept temperature and JSON mode (response_format json_object).
TOPIC_API_URL=
TOPIC_API_KEY=
TOPIC_API_MODEL=
# Sent as reasoning_effort when set, e.g. low; leave empty if unsure.
TOPIC_API_REASONING=

# --- Panel page (http://localhost:8090/frame.png) ---
# Reachable from your local network by default, and it shows what the room
# talked about. Lock the settings page with a password under System >
# Security. The frame's picture can't sign in; to hide it too, set a
# PANEL_TOKEN (letters, digits, - and _): everything then lives at
#   http://<this-machine>:8090/<PANEL_TOKEN>/frame.png
# and a frame gets FRAME_URL=http://<this-machine>:8090/<PANEL_TOKEN>
# PANEL_BIND=127.0.0.1 limits it to this machine only.
PANEL_TOKEN=
PANEL_BIND=
# The page answers to an IP address, localhost and local names (brain,
# brain.local). Reached under another name, such as a reverse proxy's domain
# or a VPN name? List the names here, separated by commas.
EMAKI_HOSTS=

# --- Microphone (PulseAudio or PipeWire socket) ---
# Linux: the default is your own session's socket, $XDG_RUNTIME_DIR/pulse/native.
# E-maki runs as user 1000; if `id -u` says something else, set both ids.
# Windows (WSL): PULSE_SOCKET=/mnt/wslg/PulseServer (see docs/wsl.md).
PULSE_SOCKET=
EMAKI_UID=
EMAKI_GID=

# --- Network microphone (optional, see docs/network-mic.md) ---
# Set NET_MIC_BIND to turn it on: 0.0.0.0 hears senders on your whole
# network, 127.0.0.1 only this machine. NET_MIC_PORT is the port (10700).
NET_MIC_PORT=
NET_MIC_BIND=
